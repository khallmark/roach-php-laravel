{
    "name": "roach-php/laravel",
    "description": "Laravel adapter for roach-php/core",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Neurotypic AI"
        },
        {
            "name": "Kai Sassnowski",
            "email": "me@kai-sassnowski.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "roach-php/core": "dev-codex/palmetto-bug-php as 1.0.0",
        "spatie/laravel-package-tools": "^1.11"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.52",
        "ergebnis/php-cs-fixer-config": "^6.62",
        "larastan/larastan": "^3.10",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5.8",
        "roave/security-advisories": "dev-latest",
        "spatie/phpunit-snapshot-assertions": "^5.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/khallmark/roach-php-core.git",
            "no-api": true
        }
    ],
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "RoachPHP\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoachPHP\\Laravel\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoachPHP\\Laravel\\RoachServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-install-cmd": [
            "composer normalize"
        ],
        "post-update-cmd": [
            "composer normalize"
        ],
        "analyze": [
            "vendor/bin/phpstan --memory-limit=1G"
        ],
        "coding-standards": [
            "mkdir -p .build/php-cs-fixer",
            "php-cs-fixer fix --diff --verbose"
        ],
        "coding-standards-check": [
            "mkdir -p .build/php-cs-fixer",
            "php-cs-fixer fix --diff --verbose --dry-run"
        ]
    }
}
